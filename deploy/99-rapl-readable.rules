# Allow user-session Cosmic Pulse to read CPU package power (RAPL energy counters).
# energy_uj is root-only by default on many kernels (incl. AMD powercap using the
# intel-rapl sysfs ABI).
#
# Install:
#   sudo cp deploy/99-rapl-readable.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger -s powercap
#   # or reboot
#
# Uninstall: remove the file and reload udev.

ACTION=="add", SUBSYSTEM=="powercap", KERNEL=="intel-rapl:[0-9]*", \
  RUN+="/bin/chmod a+r /sys/class/powercap/%k/energy_uj"
