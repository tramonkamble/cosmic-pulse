# Install: mkdir -p ~/.config/systemd/user
#         cp deploy/pulse.service ~/.config/systemd/user/pulse.service
# Edit WorkingDirectory and ExecStart paths for your home directory, then:
#         systemctl --user daemon-reload
#         systemctl --user enable --now pulse

[Unit]
Description=Cosmic Pulse gaming performance dashboard
Documentation=file:///home/USER/perf-dashboard/server.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/USER/perf-dashboard
ExecStart=/usr/bin/python3 /home/USER/perf-dashboard/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target