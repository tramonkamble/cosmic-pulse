# Legacy template — prefer: ./install.sh --service
# Or use deploy/cosmic-pulse.service (shipped in .deb under cosmic-pulse.service).

[Unit]
Description=Cosmic Pulse gaming performance dashboard
Documentation=file:///home/USER/.local/share/cosmic-pulse/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/USER/.local/bin/cosmic-pulse
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target